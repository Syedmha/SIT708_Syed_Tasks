<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB"
    android:padding="32dp">

    <!--
        VERTICAL CHAIN EXPLANATION:
        A chain links views top-to-bottom. 'packed' style clusters them
        together in the centre of the screen.
        Chain head is tvTitle (has constraintVertical_chainStyle).
        Chain tail is btnShowAll (has bottom constraint to parent).
        All views in between just reference each other top-to-bottom.
    -->

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- App title — CHAIN HEAD                                  -->
    <!-- Centred horizontally with Start+End+bias=0.5           -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lost &amp; Found"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#1A56DB"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- Subtitle                                                -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="University Lost &amp; Found Noticeboard"
        android:textSize="16sp"
        android:textColor="#6B7280"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintBottom_toTopOf="@id/btnCreateAdvert"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- Create Advert button                                    -->
    <!-- width=0dp + Start/End constraints = full available width-->
    <!-- ═══════════════════════════════════════════════════════ -->
    <Button
        android:id="@+id/btnCreateAdvert"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="Create New Advert"
        android:textSize="18sp"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintBottom_toTopOf="@id/btnShowAll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- Show All button — CHAIN TAIL                           -->
    <!-- bottom_toBottomOf='parent' closes the vertical chain   -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <Button
        android:id="@+id/btnShowAll"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="Show All Lost &amp; Found Items"
        android:textSize="18sp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnCreateAdvert"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
